# Copia a .env en local. En Render define estas mismas variables en el dashboard.
# Puerto de escucha (Render lo inyecta automáticamente).
PORT=4000
# Lista separada por comas. En producción: la URL pública de Vercel.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Ruta del JSON persistente. En Render apunta al disco (ver render.yaml).
DB_PATH=./data/db.json
